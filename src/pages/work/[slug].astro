---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projects, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Layout
  title={project.title}
  description={project.summary}
  path={`/work/${project.slug}/`}
>
  <Nav />
  <main id="main">
    <article class="pt-10 md:pt-16 pb-16 md:pb-24">
      <div class="mx-auto max-w-3xl px-6 lg:px-10">
        <a
          href="/#work"
          class="inline-flex items-center gap-2 text-sm text-mute hover:text-ink transition-colors"
        >
          <span aria-hidden="true">&larr;</span> All work
        </a>

        <header class="mt-10 reveal">
          <p class="eyebrow">{project.kind}</p>
          <h1 class="display-2 mt-4 text-ink">
            {project.title}
          </h1>
          <p
            class="mt-6 text-lg md:text-xl text-ink-soft leading-relaxed"
          >
            {project.summary}
          </p>

          <ul class="mt-8 flex flex-wrap gap-1.5">
            {
              project.tags.map((t) => (
                <li class="text-[11px] uppercase tracking-wider text-mute border border-rule px-2.5 py-1">
                  {t}
                </li>
              ))
            }
          </ul>

          {
            project.github && (
              <div class="mt-8">
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 text-sm font-medium text-ink border-b border-accent pb-0.5 hover:text-accent transition-colors"
                >
                  View on GitHub
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            )
          }
        </header>

        {
          project.cover && (
            <figure class="mt-14 reveal">
              <img
                src={project.cover}
                alt={project.coverAlt ?? project.title}
                loading="eager"
                class="w-full h-auto border border-rule"
              />
            </figure>
          )
        }

        <section class="mt-14 reveal">
          <p class="text-base md:text-lg text-ink-soft leading-relaxed">
            {project.intro}
          </p>
        </section>

        {
          project.metrics && project.metrics.length > 0 && (
            <dl class="mt-14 grid grid-cols-2 sm:grid-cols-4 gap-8 sm:gap-4 border-t border-b border-rule py-10 reveal">
              {project.metrics.map((m, i) => (
                <div class="flex flex-col gap-2 sm:px-3 sm:border-r sm:border-rule sm:last:border-r-0 sm:first:pl-0 sm:last:pr-0">
                  <dt
                    class="metric"
                    style={`color: ${i === 0 ? "var(--color-accent)" : "var(--color-ink)"};`}
                  >
                    {m.value}
                  </dt>
                  <dd class="text-xs text-mute leading-snug">{m.label}</dd>
                </div>
              ))}
            </dl>
          )
        }

        <section class="mt-14 reveal">
          <h2 class="eyebrow">What I did</h2>
          <ul class="mt-6 flex flex-col gap-5">
            {
              project.highlights.map((h) => (
                <li class="flex gap-4 text-base md:text-lg text-ink-soft leading-relaxed">
                  <span
                    class="mt-2.5 h-1 w-3 shrink-0"
                    style="background: var(--color-accent);"
                    aria-hidden="true"
                  />
                  <span>{h}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="mt-14 reveal">
          <h2 class="eyebrow">Tools & techniques</h2>
          <ul class="mt-6 flex flex-wrap gap-2">
            {
              project.tech.map((t) => (
                <li class="text-xs uppercase tracking-wider text-mute border border-rule px-3 py-1.5">
                  {t}
                </li>
              ))
            }
          </ul>
        </section>

        {
          project.context && (
            <section class="mt-14 reveal">
              <h2 class="eyebrow">Context</h2>
              <p class="mt-4 text-base text-mute leading-relaxed">
                {project.context}
              </p>
            </section>
          )
        }

        {
          project.note && (
            <aside
              class="mt-14 p-6 border-l-2 border-accent bg-paper-2/50 text-sm text-ink-soft leading-relaxed reveal"
            >
              <p class="eyebrow text-accent mb-2">Note</p>
              {project.note}
            </aside>
          )
        }

        <div class="mt-20 pt-10 border-t border-rule reveal">
          <a
            href="/#work"
            class="inline-flex items-center gap-2 text-sm text-mute hover:text-ink transition-colors"
          >
            <span aria-hidden="true">&larr;</span> Back to all work
          </a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>
