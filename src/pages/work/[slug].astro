---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import { projects, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<Layout
  title={project.title}
  description={project.summary}
  path={`/work/${project.slug}/`}
>
  <Nav />
  <main id="main">
    <article class="pt-10 md:pt-16 pb-16 md:pb-24">
      <div class="mx-auto max-w-4xl px-6 lg:px-10">
        <a
          href="/#work"
          class="inline-flex items-center gap-2 text-sm text-mute hover:text-ink transition-colors"
        >
          <span aria-hidden="true">&larr;</span> All work
        </a>

        <header class="mt-10 reveal">
          <p class="eyebrow">{project.kind}</p>
          <h1 class="display-2 mt-4 text-ink">
            {project.title}
          </h1>
          <p
            class="mt-6 text-lg md:text-xl text-ink-soft leading-relaxed"
          >
            {project.summary}
          </p>

          <ul class="mt-8 flex flex-wrap gap-1.5">
            {
              project.tags.map((t) => (
                <li class="text-[11px] uppercase tracking-wider text-mute border border-rule px-2.5 py-1">
                  {t}
                </li>
              ))
            }
          </ul>

          {
            project.github && (
              <div class="mt-8">
                <a
                  href={project.github}
                  target="_blank"
                  rel="noopener"
                  class="inline-flex items-center gap-2 text-sm font-medium text-ink border-b border-accent pb-0.5 hover:text-accent transition-colors"
                >
                  View on GitHub
                  <span aria-hidden="true">↗</span>
                </a>
              </div>
            )
          }
        </header>

        {
          project.cover && (
            <figure class="mt-14 reveal">
              <img
                src={project.cover}
                alt={project.coverAlt ?? project.title}
                loading="eager"
                class="w-full h-auto border border-rule"
              />
            </figure>
          )
        }

      </div>

      {
        project.demos && project.demos.length > 0 && (
          <div class="mx-auto max-w-5xl px-6 lg:px-10">
            <section class="mt-14 reveal">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="eyebrow">Live demos</h2>
                <span class="text-[11px] uppercase tracking-wider text-mute">
                  {project.demos.length} interactive demo
                  {project.demos.length === 1 ? "" : "s"}
                </span>
              </div>
              <p class="mt-4 text-sm text-mute leading-relaxed max-w-2xl">
                Live, interactive React dashboards running on Cloudflare. Sample
                data; client data is never exposed.
              </p>
              <p class="mt-2 text-sm text-mute leading-relaxed max-w-2xl">
                For the best experience, open the preview in a new tab.
              </p>
              <div class="mt-6 flex flex-col gap-8">
                {project.demos.map((d, i) => (
                  <figure class="demo-frame relative overflow-hidden border border-rule bg-paper-2">
                    <div class="demo-frame-bar">
                      <span class="demo-frame-dot" />
                      <span class="demo-frame-dot" />
                      <span class="demo-frame-dot" />
                      <span class="demo-frame-url" title={d.src}>
                        {d.src.replace(/^https?:\/\//, "")}
                      </span>
                      <a
                        href={d.src}
                        target="_blank"
                        rel="noopener"
                        class="demo-frame-open"
                      >
                        Open in new tab ↗
                      </a>
                    </div>
                    <div class="demo-frame-stage">
                      <iframe
                        src={d.src}
                        title={d.alt}
                        loading={i === 0 ? "eager" : "lazy"}
                        sandbox="allow-scripts allow-same-origin allow-forms allow-popups"
                        referrerpolicy="no-referrer"
                      />
                    </div>
                    {d.caption && (
                      <figcaption class="px-4 py-3 text-[11px] uppercase tracking-wider text-mute border-t border-rule">
                        {d.caption}
                      </figcaption>
                    )}
                  </figure>
                ))}
              </div>
            </section>
          </div>
        )
      }

      {
        project.mockups && project.mockups.length > 0 && (
          <div class="mx-auto max-w-7xl px-6 lg:px-10" data-mockups-section>
            <section class="mt-14 reveal">
              <div class="flex items-baseline justify-between gap-4">
                <h2 class="eyebrow">Dashboard mockups</h2>
                <span class="text-[11px] uppercase tracking-wider text-mute">
                  {project.mockups.length} masked preview
                  {project.mockups.length === 1 ? "" : "s"}
                </span>
              </div>
              <div class="mt-6 grid grid-cols-1 sm:grid-cols-2 gap-3">
                {project.mockups.map((m) => (
                  <figure class="mockup-thumb overflow-hidden border border-rule bg-paper-2">
                    <img
                      src={m.src}
                      alt={m.alt}
                      loading="lazy"
                      class="w-full h-auto cursor-zoom-in transition-transform duration-500 hover:scale-[1.02]"
                    />
                  </figure>
                ))}
              </div>
            </section>

            <div
              class="lightbox"
              role="dialog"
              aria-modal="true"
              aria-label="Dashboard preview expanded"
            >
              <button class="lightbox-close" aria-label="Close preview">✕</button>
              <img class="lightbox-img" src="" alt="" />
            </div>
          </div>
        )
      }

      {
        project.mockups && project.mockups.length > 0 && (
          <button
            class="scroll-badge"
            data-scroll-badge
            aria-label="Show dashboard screenshots"
          >
            <span class="scroll-badge-text">
              {project.mockups.length} dashboard screenshots below
            </span>
            <span class="scroll-badge-arrow" aria-hidden="true">↓</span>
          </button>
        )
      }

      <div class="mx-auto max-w-4xl px-6 lg:px-10">
        <section class="mt-14 reveal">
          <p class="text-base md:text-lg text-ink-soft leading-relaxed">
            {project.intro}
          </p>
        </section>

        {
          project.metrics && project.metrics.length > 0 && (
            <dl
              class:list={[
                "mt-14 grid grid-cols-2 gap-8 sm:gap-4 border-t border-b border-rule py-10 reveal",
                project.metrics.length === 2
                  ? "sm:grid-cols-2"
                  : project.metrics.length === 3
                    ? "sm:grid-cols-3"
                    : "sm:grid-cols-4",
              ]}
            >
              {project.metrics.map((m, i) => (
                <div class="flex flex-col gap-2 sm:px-3 sm:border-r sm:border-rule sm:last:border-r-0 sm:first:pl-0 sm:last:pr-0">
                  <dt
                    class="metric"
                    style={`color: ${i === 0 ? "var(--color-accent)" : "var(--color-ink)"};`}
                  >
                    {m.value}
                  </dt>
                  <dd class="text-xs text-mute leading-snug">{m.label}</dd>
                </div>
              ))}
            </dl>
          )
        }

        <section class="mt-14 reveal">
          <h2 class="eyebrow">What I did</h2>
          <ul class="mt-6 flex flex-col gap-5">
            {
              project.highlights.map((h) => (
                <li class="flex gap-4 text-base md:text-lg text-ink-soft leading-relaxed">
                  <span
                    class="mt-2.5 h-1 w-3 shrink-0"
                    style="background: var(--color-accent);"
                    aria-hidden="true"
                  />
                  <span>{h}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section class="mt-14 reveal">
          <h2 class="eyebrow">Tools & techniques</h2>
          <ul class="mt-6 flex flex-wrap gap-2">
            {
              project.tech.map((t) => (
                <li class="text-xs uppercase tracking-wider text-mute border border-rule px-3 py-1.5">
                  {t}
                </li>
              ))
            }
          </ul>
        </section>

        {
          project.context && (
            <section class="mt-14 reveal">
              <h2 class="eyebrow">Context</h2>
              <p class="mt-4 text-base text-mute leading-relaxed">
                {project.context}
              </p>
            </section>
          )
        }

        {
          project.note && (
            <aside
              class="mt-14 p-6 border-l-2 border-accent bg-paper-2/50 text-sm text-ink-soft leading-relaxed reveal"
            >
              <p class="eyebrow text-accent mb-2">Note</p>
              {project.note}
            </aside>
          )
        }

        <div class="mt-20 pt-10 border-t border-rule reveal">
          <a
            href="/#work"
            class="inline-flex items-center gap-2 text-sm text-mute hover:text-ink transition-colors"
          >
            <span aria-hidden="true">&larr;</span> Back to all work
          </a>
        </div>
      </div>
    </article>
  </main>
  <Footer />
</Layout>

<style>
  /* Floating "more below" badge. Centered at bottom, rounded, with border. */
  .scroll-badge {
    position: fixed;
    bottom: 32px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 24px;
    background: var(--color-ink);
    color: var(--color-paper);
    border: 1.5px solid var(--color-accent);
    border-radius: 50px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    opacity: 1;
    transition:
      opacity 300ms ease,
      transform 300ms ease;
    pointer-events: auto;
    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.25);
  }
  .scroll-badge.hidden {
    opacity: 0;
    transform: translateX(-50%) translateY(20px);
    pointer-events: none;
  }
  .scroll-badge:hover {
    border-color: var(--color-paper);
  }
  .scroll-badge-icon {
    display: flex;
    align-items: center;
  }
  .scroll-badge-arrow {
    display: inline-block;
    font-size: 16px;
    animation: badge-bounce 2s ease-in-out infinite;
  }
  @keyframes badge-bounce {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(4px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-badge-arrow {
      animation: none;
    }
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0, 0, 0, 0.85);
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease;
  }
  .lightbox.open {
    opacity: 1;
    pointer-events: auto;
  }
  .lightbox img {
    max-width: 92%;
    max-height: 92%;
    object-fit: contain;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.5);
  }
  .lightbox-close {
    position: absolute;
    top: 20px;
    right: 24px;
    width: 40px;
    height: 40px;
    border: none;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    font-size: 20px;
    line-height: 1;
    cursor: pointer;
    border-radius: 50%;
    transition: background 200ms ease;
  }
  .lightbox-close:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .demo-frame {
    box-shadow: 0 24px 60px -28px rgba(10, 10, 10, 0.28);
  }
  .demo-frame-bar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-paper);
  }
  .demo-frame-dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-rule);
  }
  .demo-frame-dot:first-child {
    background: var(--color-accent);
    opacity: 0.7;
  }
  .demo-frame-url {
    margin-left: 10px;
    flex: 1;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--color-mute);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .demo-frame-open {
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-mute);
    border-bottom: 1px solid transparent;
    transition: color 200ms ease, border-color 200ms ease;
  }
  .demo-frame-open:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
  .demo-frame-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-paper-2);
    overflow: hidden;
    container-type: inline-size;
    /* GPU-rasterize so the scaled iframe stays crisp on Chromium. */
    transform: translateZ(0);
  }
  .demo-frame-stage iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 1600px;
    height: 900px;
    border: 0;
    display: block;
    transform-origin: top left;
    transform: scale(calc(100cqi / 1600px));
  }
  @supports not (width: 100cqi) {
    .demo-frame-stage iframe {
      transform: scale(0.6);
    }
  }
  @media (max-width: 640px) {
    .demo-frame-stage {
      aspect-ratio: 4 / 3;
    }
    .demo-frame-stage iframe {
      width: 1280px;
      height: 960px;
      transform: scale(calc(100cqi / 1280px));
    }
  }
</style>

<script>
  /* Lightbox */
  const lightbox = document.querySelector(".lightbox");
  const lightboxImg = lightbox?.querySelector(".lightbox-img");
  const closeBtn = lightbox?.querySelector(".lightbox-close");

  document.querySelectorAll(".mockup-thumb img").forEach((img) => {
    img.addEventListener("click", () => {
      if (!lightbox || !lightboxImg) return;
      lightboxImg.src = img.src;
      lightboxImg.alt = img.alt;
      lightbox.classList.add("open");
      document.body.style.overflow = "hidden";
    });
  });

  function closeLightbox() {
    if (!lightbox) return;
    lightbox.classList.remove("open");
    document.body.style.overflow = "";
  }

  closeBtn?.addEventListener("click", closeLightbox);
  lightbox?.addEventListener("click", (e) => {
    if (e.target === lightbox) closeLightbox();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") closeLightbox();
  });

  /* Floating "more below" badge — hide when mockups section is visible. */
  (function () {
    const badge = document.querySelector("[data-scroll-badge]");
    const section = document.querySelector("[data-mockups-section]");
    if (!badge || !section) return;

    function checkVisibility() {
      const rect = section.getBoundingClientRect();
      const visible = rect.top < window.innerHeight * 0.8;
      badge.classList.toggle("hidden", visible);
    }

    badge.addEventListener("click", () => {
      section.scrollIntoView({ behavior: "smooth", block: "start" });
    });

    window.addEventListener("scroll", checkVisibility, { passive: true });
    checkVisibility();
  })();
</script>
