---
const groups = [
  {
    label: "Business Intelligence",
    items: [
      "Power BI",
      "DAX",
      "Data modeling",
      "KPI design",
      "Dashboard architecture",
      "Report design",
    ],
  },
  {
    label: "Data & Programming",
    items: [
      "Python",
      "SQL",
      "PostgreSQL",
      "MySQL",
      "Pandas · NumPy",
      "Matplotlib · Seaborn",
      "Scikit-learn",
      "SQLAlchemy",
    ],
  },
  {
    label: "Workflow & Tooling",
    items: [
      "Excel · Power Query",
      "Google Sheets",
      "Jupyter",
      "Git · GitHub",
      "Docker",
      "AI-assisted development (Claude Code)",
      "ETL pipeline development",
      "Cross-functional collaboration",
    ],
  },
];
---

<section class="py-16 md:py-24 border-b border-rule">
  <div class="mx-auto max-w-6xl px-6 lg:px-10">
    <div class="reveal flex items-baseline gap-4 md:gap-6">
      <span class="section-numeral">03</span>
      <p class="eyebrow">Skills</p>
    </div>
    <h2 class="display-2 mt-5 max-w-4xl reveal">
      The toolkit, organized.
    </h2>

    <div class="mt-16 md:mt-20 grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-10">
      {
        groups.map((group) => (
          <div class="reveal">
            <h3 class="font-display text-2xl text-ink leading-tight">
              {group.label}
            </h3>
            <div class="mt-4 h-px w-10 bg-accent" />
            <ul class="mt-6 flex flex-col gap-3">
              {group.items.map((item) => (
                <li class="text-base text-ink-soft">{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
