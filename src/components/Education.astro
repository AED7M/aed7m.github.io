---
const items = [
  {
    date: "Expected 2027",
    title: "B.Sc. Artificial Intelligence Engineering",
    org: "Mansoura University",
    detail:
      "Studying AI engineering with focus on machine learning, data analysis, and intelligent systems.",
  },
  {
    date: "May 2025",
    title: "Data Science Course",
    org: "ALX × Explore AI",
    detail:
      "13-month program covering statistical analysis, machine learning, data visualization, and applied projects.",
  },
  {
    date: "August 2024",
    title: "Certified Data Analyst",
    org: "DataCamp",
    detail:
      "Professional certification verifying data manipulation, visualization, and statistical analysis competence.",
  },
];
---

<section class="py-24 md:py-36 border-b border-rule">
  <div class="mx-auto max-w-6xl px-6 lg:px-10">
    <div class="reveal">
      <p class="eyebrow">Education & Certifications</p>
      <h2 class="display-2 mt-4 max-w-3xl">Background.</h2>
    </div>

    <ol class="mt-16 md:mt-20 flex flex-col">
      {
        items.map((item, i) => (
          <li
            class={`reveal flex flex-col md:flex-row gap-3 md:gap-10 py-8 ${
              i === 0 ? "border-t border-rule" : ""
            } border-b border-rule`}
          >
            <div class="md:w-40 shrink-0">
              <p class="eyebrow text-mute">{item.date}</p>
            </div>
            <div class="flex-1">
              <h3 class="font-display text-xl md:text-2xl text-ink leading-tight">
                {item.title}
              </h3>
              <p class="mt-1 text-sm text-mute">{item.org}</p>
              <p class="mt-3 text-base text-ink-soft leading-relaxed max-w-2xl">
                {item.detail}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
