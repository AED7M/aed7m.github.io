---
const stats = [
  { value: "10+", label: "Production dashboards shipped" },
  { value: "2", label: "Production stacks owned end to end (Power BI + React)" },
  { value: "4", label: "Areas of expertise: BI, ETL, ML, and automation" },
];
---

<section
  id="top"
  class="hero-spotlight relative pt-6 md:pt-12 pb-16 md:pb-24 border-b border-rule"
>
  <div class="mx-auto max-w-7xl px-6 lg:px-10 relative">
    <p class="eyebrow hero-rise">
      Microsoft Certified Data Analyst <span class="mx-1 text-mute-soft">/</span> Remote
    </p>

    <h1 class="display-1 mt-5 md:mt-7 max-w-5xl hero-rise" style="animation-delay: 120ms;">
      Turning consumer <span class="accent-mark">intelligence</span> into
      business decisions.
    </h1>

    <p
      class="display-3 mt-5 md:mt-7 max-w-3xl text-mute hero-rise"
      style="animation-delay: 240ms;"
    >
      <span class="serif-italic">I build production dashboards for enterprise brands.</span>
    </p>

    <div
      class="mt-8 max-w-2xl text-base md:text-lg text-ink-soft leading-relaxed hero-rise"
      style="animation-delay: 360ms;"
    >
      <p>
        Microsoft Certified Power BI Data Analyst (PL-300). Most recently at <a
          href="#experience"
          class="prose-link font-medium text-ink">Muhimma Digital</a
        >, where I owned the lifecycle of Power BI and React dashboards used
        daily by major brands. I work end to end, from raw research data and
        architecture documents to interactive tools that executives actually
        rely on.
      </p>
    </div>

    <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 hero-rise" style="animation-delay: 480ms;">
      <a
        href="/work/muhimma-dashboards/"
        class="btn-cta inline-flex items-center justify-center gap-2 text-paper px-6 py-3 text-sm font-medium"
      >
        <span class="btn-text">View my work</span>
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-2 text-ink px-6 py-3 text-sm font-medium border border-ink/15 hover:border-ink transition-colors duration-200"
      >
        Get in touch
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="/resume/Abdelrahman_Elaref_Data_Analyst.pdf"
        data-resume-preview
        class="inline-flex items-center justify-center gap-2 text-ink px-6 py-3 text-sm font-medium border border-ink/15 hover:border-ink transition-colors duration-200"
      >
        View resume
      </a>
    </div>

    <!-- Editorial stats strip. md+: 3-col grid. Mobile: vertical stack. -->
    <dl
      class="mt-10 md:mt-20 grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-6 border-t border-rule pt-8 md:pt-10"
    >
      {
        stats.map((stat) => (
          <div class="flex flex-col gap-2 md:gap-3 md:px-6 md:border-r md:border-rule md:last:border-r-0 md:first:pl-0 md:last:pr-0">
            <dt class="metric text-ink">{stat.value}</dt>
            <dd class="text-sm text-mute leading-snug max-w-xs">
              {stat.label}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>

</section>

<script>
  (function () {
    const hero = document.querySelector(".hero-spotlight");
    if (!hero) return;

    let glowDiv;
    function createGlow() {
      glowDiv = document.createElement("div");
      glowDiv.className = "hero-glow";
      hero.prepend(glowDiv);
    }
    createGlow();

    let x = 0, y = 0, raf = null;
    hero.addEventListener("mousemove", (e) => {
      const rect = hero.getBoundingClientRect();
      x = e.clientX - rect.left;
      y = e.clientY - rect.top;
      if (!raf) {
        raf = requestAnimationFrame(() => {
          glowDiv.style.setProperty("--gx", x + "px");
          glowDiv.style.setProperty("--gy", y + "px");
          glowDiv.style.opacity = "1";
          raf = null;
        });
      }
    });

    hero.addEventListener("mouseleave", () => {
      glowDiv.style.opacity = "0";
    });
  })();
</script>

<style>
  .hero-spotlight {
    position: relative;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: 0;
    transition: opacity 400ms ease;
    background: radial-gradient(
      600px circle at var(--gx, 50%) var(--gy, 50%),
      rgba(34, 71, 255, 0.06),
      transparent 40%
    );
    z-index: 0;
  }
  .hero-spotlight > .mx-auto {
    position: relative;
    z-index: 1;
  }
</style>
