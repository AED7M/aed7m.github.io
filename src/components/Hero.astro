---
const stats = [
  { value: "8+", label: "Production dashboards shipped" },
  { value: "85+", label: "Enterprise brand clients reached" },
  { value: "400k+", label: "Verified consumers in datasets" },
];
---

<section
  id="top"
  class="relative pt-16 md:pt-28 pb-20 md:pb-32 border-b border-rule"
>
  <div class="mx-auto max-w-6xl px-6 lg:px-10">
    <p class="eyebrow reveal">
      Data Analyst <span class="mx-1 text-mute-soft">·</span> Remote
      <span class="mx-1 text-mute-soft">·</span> KSA / UAE
    </p>

    <h1 class="display-1 mt-6 md:mt-8 max-w-4xl reveal">
      Turning consumer
      <span class="italic" style="color: var(--color-accent);">intelligence</span>
      into business decisions.
    </h1>

    <p
      class="display-3 mt-6 md:mt-8 max-w-3xl text-mute font-display italic reveal"
    >
      I build production dashboards for enterprise brands across Saudi Arabia
      and the UAE.
    </p>

    <div
      class="mt-8 max-w-2xl text-base md:text-lg text-ink-soft leading-relaxed reveal"
    >
      <p>
        Most recently at <a
          href="#experience"
          class="prose-link font-medium text-ink">Muhimma Digital</a
        >, where I owned the lifecycle of Power BI and React dashboards used
        daily by major brands across the region. I work end-to-end — from raw
        research data and architecture documents to interactive tools that
        executives actually rely on.
      </p>
    </div>

    <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 reveal">
      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-2 bg-ink text-paper px-6 py-3 text-sm font-medium hover:bg-accent transition-colors duration-200"
      >
        Get in touch
        <span aria-hidden="true">&rarr;</span>
      </a>
      <a
        href="/resume/Abdelrahman_Elaref_Resume.pdf"
        download
        class="inline-flex items-center justify-center gap-2 text-ink px-6 py-3 text-sm font-medium border border-ink/15 hover:border-ink transition-colors duration-200"
      >
        Download resume
      </a>
    </div>

    <!-- Editorial stats strip. On mobile: horizontal scroll. On md+: 3-col grid with rules. -->
    <dl
      class="mt-16 md:mt-24 hidden md:grid md:grid-cols-3 gap-6 border-t border-rule pt-12"
    >
      {
        stats.map((stat, i) => (
          <div class="flex flex-col gap-3 px-6 border-r border-rule last:border-r-0 first:pl-0 last:pr-0">
            <dt class="metric text-ink">{stat.value}</dt>
            <dd class="text-sm text-mute leading-snug max-w-xs">
              {stat.label}
            </dd>
          </div>
        ))
      }
    </dl>

    <!-- Mobile-only stats: horizontal scroll snap -->
    <div
      class="md:hidden mt-12 -mx-6 px-6 overflow-x-auto pt-10 border-t border-rule scroll-px-6 snap-x snap-mandatory"
      role="list"
    >
      <dl class="flex gap-6 min-w-max">
        {
          stats.map((stat) => (
            <div
              class="flex flex-col gap-2 min-w-[55vw] snap-start border-r border-rule pr-6 last:border-r-0 last:pr-0"
              role="listitem"
            >
              <dt class="metric text-ink">{stat.value}</dt>
              <dd class="text-xs text-mute leading-snug">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
      <p class="mt-3 text-[11px] uppercase tracking-wider text-mute-soft">
        Swipe →
      </p>
    </div>
  </div>
</section>
