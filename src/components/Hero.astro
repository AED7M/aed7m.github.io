---
const stats = [
  { value: "10+", label: "Production dashboards shipped" },
  { value: "15+", label: "Data sources integrated" },
  { value: "9", label: "Climate risk pathways simulated" },
];
---

<section
  id="top"
  class="relative pt-6 md:pt-12 pb-16 md:pb-24 border-b border-rule overflow-hidden"
>
  <div class="mx-auto max-w-6xl px-6 lg:px-10 relative">
    <p class="eyebrow reveal">
      Data Analyst <span class="mx-1 text-mute-soft">/</span> Remote
    </p>

    <h1 class="display-1 mt-5 md:mt-7 max-w-5xl reveal">
      Turning consumer <span class="accent-mark">intelligence</span> into
      business decisions.
    </h1>

    <p
      class="display-3 mt-5 md:mt-7 max-w-3xl text-mute reveal"
    >
      <span class="serif-italic">I build production dashboards for enterprise brands.</span>
    </p>

    <div
      class="mt-8 max-w-2xl text-base md:text-lg text-ink-soft leading-relaxed reveal"
    >
      <p>
        Most recently at <a
          href="#experience"
          class="prose-link font-medium text-ink">Muhimma Digital</a
        >, where I owned the lifecycle of Power BI and React dashboards used
        daily by major brands. I work end to end, from raw research data and
        architecture documents to interactive tools that executives actually
        rely on.
      </p>
    </div>

    <div class="mt-10 flex flex-col sm:flex-row sm:items-center gap-3 sm:gap-4 reveal">
      <a
        href="#contact"
        class="inline-flex items-center justify-center gap-2 bg-ink text-paper px-6 py-3 text-sm font-medium hover:bg-accent transition-colors duration-200"
      >
        Get in touch
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="/resume/Abdelrahman_Elaref_Resume.pdf"
        download
        class="inline-flex items-center justify-center gap-2 text-ink px-6 py-3 text-sm font-medium border border-ink/15 hover:border-ink transition-colors duration-200"
      >
        Download resume
      </a>
    </div>

    <!-- Editorial stats strip. md+: 3-col grid. Mobile: horizontal scroll. -->
    <dl
      class="mt-14 md:mt-20 hidden md:grid md:grid-cols-3 gap-6 border-t border-rule pt-10"
    >
      {
        stats.map((stat) => (
          <div class="flex flex-col gap-3 px-6 border-r border-rule last:border-r-0 first:pl-0 last:pr-0">
            <dt class="metric text-ink">{stat.value}</dt>
            <dd class="text-sm text-mute leading-snug max-w-xs">
              {stat.label}
            </dd>
          </div>
        ))
      }
    </dl>

    <div
      class="md:hidden mt-10 -mx-6 px-6 overflow-x-auto pt-8 border-t border-rule snap-x snap-mandatory"
      role="list"
    >
      <dl class="flex gap-6 min-w-max">
        {
          stats.map((stat) => (
            <div
              class="flex flex-col gap-2 min-w-[55vw] snap-start border-r border-rule pr-6 last:border-r-0 last:pr-0"
              role="listitem"
            >
              <dt class="metric text-ink">{stat.value}</dt>
              <dd class="text-xs text-mute leading-snug">{stat.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>

</section>
