---
const roles = [
  {
    company: "Muhimma Digital Platform Co.",
    role: "Data Analyst",
    period: "Sep 2025 — Apr 2026",
    duration: "8 months",
    location: "Remote · KSA / UAE",
    summary:
      "Owned the full lifecycle of production-grade dashboards used by enterprise brand clients of one of the region's leading consumer intelligence companies. Translated raw research data and architecture documents into interactive tools for executive decision-makers — from data modeling and KPI design through visual logic and shipping to production.",
    metrics: [
      { value: "8+", label: "Power BI dashboards in production" },
      { value: "2", label: "React dashboards architected end-to-end" },
      { value: "85+", label: "Enterprise brand clients served" },
    ],
    bullets: [
      "Built and maintained production Power BI dashboards used daily by enterprise brand clients across multiple retail categories in KSA and UAE — owning data modeling, DAX measures, visual design, and performance optimization.",
      "Architected and shipped 2 production React dashboards as product owner, directing AI-assisted implementation through to enterprise-quality release. Defined requirements, structured data flow, designed UX, and acted as the quality gate.",
      "Translated multi-stage market research projects into dashboards that made complex consumer intelligence accessible to non-technical decision-makers.",
      "Iterated on existing dashboards by shipping new features, improving UX, and resolving data issues based on direct client feedback loops.",
    ],
    skills: [
      "Power BI",
      "DAX",
      "Data modeling",
      "KPI design",
      "Python",
      "React (AI-assisted)",
      "Excel · Power Query",
      "Client-ready BI",
    ],
  },
  {
    company: "Sustainly.tech",
    role: "Data Analyst Intern",
    period: "Jul 2025 — Present",
    duration: "",
    location: "Remote",
    summary:
      "Climate risk and financial modeling work supporting corporate decision-making on the energy transition. Built scenario-based analyses across multiple sectors using historical emissions, financial disclosures, and academic research.",
    metrics: [
      { value: "9", label: "Climate risk pathways simulated" },
      { value: "$2.15B", label: "Top-end carbon cost projection (2030–2060)" },
      { value: "85–91%", label: "Cost savings under Net Zero vs. BAU" },
    ],
    bullets: [
      "Executed comprehensive climate risk assessments across 8 sectors by integrating data from 15+ sources, identifying key physical and transition risk drivers.",
      "Built scenario-based financial models in Python integrating 9 years of historical emissions and financial data, projecting carbon cost exposure ranging from $325M to $2.15B (2030–2060).",
      "Quantified agricultural sector vulnerabilities, revealing it absorbs 82% of drought-related economic impacts and contributes ~20% of global GHG emissions.",
      "Simulated 9 climate risk pathways showing 85–91% cost savings under a Net Zero scenario versus Business-as-Usual, providing actionable corporate recommendations.",
    ],
    skills: [
      "Python",
      "Financial modeling",
      "Climate risk analysis",
      "Data integration",
      "Scenario analysis",
    ],
  },
];
---

<section
  id="experience"
  class="py-24 md:py-36 border-b border-rule"
>
  <div class="mx-auto max-w-6xl px-6 lg:px-10">
    <div class="reveal">
      <p class="eyebrow">Experience</p>
      <h2 class="display-2 mt-4 max-w-3xl">
        Where I&rsquo;ve put the craft to work.
      </h2>
    </div>

    <div class="mt-20 md:mt-28 flex flex-col gap-24 md:gap-32">
      {
        roles.map((role) => (
          <article class="reveal">
            <header class="flex flex-col gap-3">
              <p class="eyebrow text-mute">
                {role.period}
                {role.duration && <span class="mx-2 text-mute-soft">·</span>}
                {role.duration && <span>{role.duration}</span>}
                <span class="mx-2 text-mute-soft">·</span>
                <span>{role.location}</span>
              </p>
              <h3 class="display-2 text-ink leading-tight">
                {role.company}
              </h3>
              <p class="display-3 text-mute font-display italic">
                {role.role}
              </p>
            </header>

            <p class="mt-8 max-w-3xl text-lg text-ink-soft leading-relaxed">
              {role.summary}
            </p>

            <dl class="mt-12 grid grid-cols-1 sm:grid-cols-3 gap-8 sm:gap-4 border-t border-b border-rule py-10">
              {role.metrics.map((m, i) => (
                <div class="flex flex-col gap-2 sm:px-4 sm:border-r sm:border-rule sm:last:border-r-0 sm:first:pl-0 sm:last:pr-0">
                  <dt class="metric text-ink" style={`color: ${i === 0 ? "var(--color-accent)" : "var(--color-ink)"};`}>
                    {m.value}
                  </dt>
                  <dd class="text-sm text-mute leading-snug">{m.label}</dd>
                </div>
              ))}
            </dl>

            <ul class="mt-12 flex flex-col gap-5 max-w-3xl">
              {role.bullets.map((b) => (
                <li class="flex gap-4 text-base md:text-lg text-ink-soft leading-relaxed">
                  <span
                    class="mt-2.5 h-1 w-3 shrink-0"
                    style="background: var(--color-accent);"
                    aria-hidden="true"
                  />
                  <span>{b}</span>
                </li>
              ))}
            </ul>

            <ul class="mt-10 flex flex-wrap gap-2">
              {role.skills.map((s) => (
                <li class="text-xs uppercase tracking-wider text-mute border border-rule px-3 py-1.5">
                  {s}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
